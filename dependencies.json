{
  "arch": "auto",
  "install_prefix": "deps",
  "extract_dir": "3rdparty",
  "deps-source": {
    "repo": "Chen-Christins/chen",
    "tag": "v1.0.0",
    "asset": "3rdparty.zip"
  },
  "deps-package": {
    "repo": "Chen-Christins/chen",
    "tag": "v1.0.0",
    "asset": "deps-{arch}.zip"
  },
  "packages": [
    {
      "name": "yaml-cpp",
      "from": "yaml-cpp-0.9.0.zip",
      "dir": "yaml-cpp-yaml-cpp-0.9.0",
      "type": "cmake",
      "args": ["-DBUILD_SHARED_LIBS=OFF", "-DYAML_CPP_BUILD_TESTS=OFF"]
    },
    {
      "name": "ragel",
      "from": "ragel-6.10.tar.gz",
      "dir": "ragel-6.10",
      "type": "autotools"
    },
    {
      "name": "tinyxml2",
      "dir": "tinyxml2",
      "type": "cmake",
      "args": ["-DBUILD_SHARED_LIBS=OFF"]
    },
    {
      "name": "hiredis-vip",
      "dir": "hiredis-vip",
      "type": "make",
      "install_prefix_var": "PREFIX"
    },
    {
      "name": "jsoncpp",
      "dir": "jsoncpp",
      "type": "cmake",
      "args": ["-DBUILD_SHARED_LIBS=OFF"]
    },
    {
      "name": "protobuf",
      "from": "protobuf-all-3.12.4.tar.gz",
      "dir": "protobuf-3.12.4",
      "type": "autotools",
      "args": ["--disable-shared"]
    }
  ]
}
